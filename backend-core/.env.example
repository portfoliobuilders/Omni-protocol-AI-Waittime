# Omni Protocol backend-core — environment configuration
# Copy this file to ".env" for local dev, or set these as environment
# variables in your cloud host (e.g. Railway). All values are optional;
# sensible defaults are used when a variable is not set.

# Filesystem path to the better-sqlite3 database file.
# If unset, defaults to "omni-ledger.db" in the process working directory.
# On Railway, point this at a mounted volume so data persists across deploys,
# e.g. OMNI_DB_PATH=/data/omni-ledger.db
# The parent directory is created automatically if it does not exist.
OMNI_DB_PATH=

# Admin dashboard / admin API key.
# If unset (local dev), /admin and /api/v1/admin/* are open as before.
# If set, requests must include ?key=THE_KEY or they receive 401 Unauthorized.
# Use a long, random value in production.
OMNI_ADMIN_KEY=

# Port the HTTP server listens on.
# If unset, defaults to 3001. Cloud hosts usually inject their own PORT.
PORT=
