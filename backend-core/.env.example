# Omni Protocol backend-core — environment configuration
# Copy this file to ".env" for local Exchange. Never commit real secrets.
# Service-role keys must NEVER appear in the Chrome extension or ads-portal bundle.

PORT=3001
OMNI_ADMIN_KEY=

# Production money ledger is Supabase Postgres (required to boot).
# Local: npx supabase start — URL/ports from supabase/config.toml
SUPABASE_URL=http://127.0.0.1:55321
SUPABASE_ANON_KEY=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# SQLite is legacy only (migration tooling / historical tests). Not the v2 money ledger.
OMNI_DB_PATH=

# Optional SDK path override for GET /sdk/omni.min.js
OMNI_SDK_PATH=
