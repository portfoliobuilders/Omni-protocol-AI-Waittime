{
  "name": "@omni-piggy/backend-core",
  "version": "0.1.0",
  "private": true,
  "description": "Omni Protocol backend — yield transaction processing",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "prebuild": "node scripts/copy-sdk.mjs",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "smoke": "tsx scripts/smoke-test.ts",
    "test:money": "tsx ../shared/money/micropaise.test.ts",
    "test:exchange": "tsx scripts/exchange-postgres-test.ts",
    "test:exchange:pg": "tsx scripts/exchange-postgres-test.ts",
    "test:rls": "tsx scripts/rls-probe.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.4",
    "better-sqlite3": "^12.11.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true,
    "esbuild@0.28.1": true
  }
}
