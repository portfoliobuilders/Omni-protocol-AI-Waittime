{
  "manifest_version": 3,
  "name": "OmniPiggy: Personal AI Dividend",
  "version": "1.0.0",
  "description": "Earn small rewards during AI wait time. Take a mindful break, answer a quick question, or claim a micro-dividend.",
  "homepage_url": "https://portfoliobuilders.in",
  "permissions": ["storage"],
  "host_permissions": [
    "https://omni-protocol-ai-waittime-production.up.railway.app/*"
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "service_worker": "background/worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "OmniPiggy",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://claude.ai/*",
        "https://chatgpt.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
