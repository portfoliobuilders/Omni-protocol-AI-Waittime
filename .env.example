# Copy to backend-core/.env for local API (never commit real secrets).
# Service role key must NEVER appear in the Chrome extension bundle.

PORT=3001
OMNI_ADMIN_KEY=change-me

# Local Supabase (npx supabase start) — ports from supabase/config.toml
SUPABASE_URL=http://127.0.0.1:55321
SUPABASE_ANON_KEY=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
